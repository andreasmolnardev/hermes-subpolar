# Optional process settings for the Bun gateway.
# Provider credentials are entered through authenticated first-run setup and
# encrypted in the private data directory, not in this file.

SUBPOLAR_HOST=127.0.0.1
SUBPOLAR_PORT=8080
SUBPOLAR_DATA_DIR=.subpolar
# Optional mounted root for project workspaces. Defaults to
# <SUBPOLAR_DATA_DIR>/workspaces.
# SUBPOLAR_WORKSPACE_ROOT=.subpolar/workspaces
# SUBPOLAR_STATIC_ROOT=packages/web-ui/dist
