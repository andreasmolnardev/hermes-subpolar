{
  "openapi": "3.1.0",
  "info": {
    "title": "Subpolar Bun API",
    "version": "0.0.0",
    "description": "Authenticated owner-scoped browser API for the Bun Subpolar gateway."
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Return liveness status",
        "responses": { "200": { "description": "Healthy", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } } } }
      }
    },
    "/api/ready": {
      "get": {
        "summary": "Return readiness status",
        "responses": { "200": { "description": "Ready", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Ready" } } } } }
      }
    },
    "/v1/auth/bootstrap": {
      "get": {
        "summary": "Return whether first-user bootstrap is required",
        "responses": {
          "200": { "description": "Bootstrap status", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BootstrapStatus" } } } }
        }
      },
      "post": {
        "summary": "Create the first local administrator and session",
        "requestBody": { "$ref": "#/components/requestBodies/Credentials" },
        "responses": {
          "201": { "$ref": "#/components/responses/SessionCreated" },
          "400": { "$ref": "#/components/responses/BootstrapFailed" },
          "403": { "$ref": "#/components/responses/OriginRejected" }
        }
      }
    },
    "/v1/auth/login": {
      "post": {
        "summary": "Create an authenticated browser session",
        "requestBody": { "$ref": "#/components/requestBodies/Credentials" },
        "responses": {
          "200": { "$ref": "#/components/responses/SessionCreated" },
          "401": { "$ref": "#/components/responses/InvalidCredentials" },
          "403": { "$ref": "#/components/responses/OriginRejected" }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "summary": "Revoke the current browser session",
        "security": [{ "sessionCookie": [] }],
        "responses": {
          "200": { "description": "Logged out", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Ok" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/CsrfOrOriginRejected" }
        }
      }
    },
    "/v1/auth/password": {
      "post": {
        "summary": "Rotate the authenticated user's password and session",
        "security": [{ "sessionCookie": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/PasswordChange" },
        "responses": {
          "200": { "$ref": "#/components/responses/SessionCreated" },
          "400": { "$ref": "#/components/responses/InvalidPassword" },
          "401": { "$ref": "#/components/responses/InvalidCredentials" },
          "403": { "$ref": "#/components/responses/CsrfOrOriginRejected" }
        }
      }
    },
    "/v1/me": {
      "get": {
        "summary": "Return the authenticated user",
        "security": [{ "sessionCookie": [] }],
        "responses": { "200": { "description": "User", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserEnvelope" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/v1/setup": {
      "get": {
        "summary": "Return authenticated first-run setup status",
        "security": [{ "sessionCookie": [] }],
        "responses": { "200": { "description": "Setup status", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SetupStatus" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/v1/settings/models": {
      "get": {
        "summary": "Return authenticated model defaults",
        "security": [{ "sessionCookie": [] }],
        "responses": { "200": { "description": "Model defaults", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ModelDefaults" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      },
      "put": {
        "summary": "Save authenticated model defaults",
        "security": [{ "sessionCookie": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/ModelDefaults" },
        "responses": { "200": { "description": "Model defaults", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ModelDefaults" } } } }, "400": { "$ref": "#/components/responses/InvalidModelDefaults" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/CsrfOrOriginRejected" } }
      }
    },
    "/v1/setup/providers": {
      "get": {
        "summary": "List provider catalog metadata",
        "security": [{ "sessionCookie": [] }],
        "responses": { "200": { "description": "Provider catalog", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProviderCatalog" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/v1/providers": {
      "get": {
        "summary": "List authenticated provider profiles",
        "security": [{ "sessionCookie": [] }],
        "responses": { "200": { "description": "Provider catalog", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProviderCatalog" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/v1/providers/{providerId}/models": {
      "get": {
        "summary": "List models for one provider profile",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ProviderId" }],
        "responses": { "200": { "description": "Provider models", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProviderModels" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "404": { "$ref": "#/components/responses/NotFound" } }
      }
    },
    "/v1/providers/{providerId}/auth/start": {
      "get": {
        "summary": "Begin provider OAuth with PKCE",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ProviderId" }, { "$ref": "#/components/parameters/ProviderModel" }, { "$ref": "#/components/parameters/ProviderBaseUrl" }],
        "responses": { "200": { "description": "OAuth authorization URL", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OAuthStart" } } } }, "400": { "$ref": "#/components/responses/InvalidProvider" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/v1/providers/{providerId}/auth/callback": {
      "get": {
        "summary": "Complete provider OAuth callback",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ProviderId" }, { "$ref": "#/components/parameters/OAuthState" }, { "$ref": "#/components/parameters/OAuthCode" }],
        "responses": { "303": { "description": "Redirect to setup" }, "400": { "$ref": "#/components/responses/InvalidProvider" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/v1/providers/{providerId}/auth/device/start": {
      "post": {
        "summary": "Begin provider device authorization",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ProviderId" }],
        "responses": { "200": { "description": "Device authorization", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeviceStart" } } } }, "400": { "$ref": "#/components/responses/InvalidProvider" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/CsrfOrOriginRejected" } }
      }
    },
    "/v1/providers/{providerId}/auth/device/complete": {
      "post": {
        "summary": "Complete provider device authorization",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ProviderId" }],
        "requestBody": { "$ref": "#/components/requestBodies/DeviceComplete" },
        "responses": { "200": { "$ref": "#/components/responses/Configured" }, "400": { "$ref": "#/components/responses/InvalidProvider" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/CsrfOrOriginRejected" } }
      }
    },
    "/v1/models": {
      "get": {
        "summary": "List models from the configured provider",
        "security": [{ "sessionCookie": [] }],
        "responses": { "200": { "description": "Available models", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ModelCatalog" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/v1/setup/provider": {
      "post": {
        "summary": "Store the administrator's provider connection",
        "security": [{ "sessionCookie": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/ProviderSetup" },
        "responses": { "200": { "description": "Configured", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Configured" } } } }, "400": { "$ref": "#/components/responses/InvalidProvider" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/CsrfOrOriginRejected" } }
      }
    },
    "/v1/setup/agents": {
      "post": {
        "summary": "Create the mandatory master and selected initial agents",
        "security": [{ "sessionCookie": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/InitialAgents" },
        "responses": { "201": { "description": "Initial agents", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InitialAgents" } } } }, "400": { "$ref": "#/components/responses/InvalidTemplates" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/CsrfOrOriginRejected" } }
      }
    },
    "/v1/projects": {
      "get": {
        "summary": "List owned projects",
        "security": [{ "sessionCookie": [] }],
        "responses": { "200": { "description": "Projects", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Projects" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      },
      "post": {
        "summary": "Create an owned project",
        "security": [{ "sessionCookie": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/ProjectCreate" },
        "responses": { "201": { "description": "Project", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProjectEnvelope" } } } }, "400": { "$ref": "#/components/responses/InvalidProject" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/CsrfOrOriginRejected" } }
      }
    },
    "/v1/agents": {
      "get": {
        "summary": "List owned agents",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ProjectId" }],
        "responses": { "200": { "description": "Agents", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Agents" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      },
      "post": {
        "summary": "Create an owned agent",
        "security": [{ "sessionCookie": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/AgentCreate" },
        "responses": { "201": { "description": "Agent", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AgentEnvelope" } } } }, "400": { "$ref": "#/components/responses/InvalidAgent" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/ForbiddenOrCsrf" } }
      }
    },
    "/v1/agents/{agentId}": {
      "get": {
        "summary": "Retrieve an owned agent",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/AgentId" }],
        "responses": { "200": { "description": "Agent", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AgentEnvelope" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "404": { "description": "Not found" } }
      },
      "patch": {
        "summary": "Update an owned agent configuration",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/AgentId" }],
        "requestBody": { "$ref": "#/components/requestBodies/AgentUpdate" },
        "responses": { "200": { "description": "Agent", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AgentEnvelope" } } } }, "400": { "$ref": "#/components/responses/InvalidAgent" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/ForbiddenOrCsrf" } }
      },
      "delete": {
        "summary": "Delete an owned agent",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/AgentId" }],
        "responses": { "200": { "description": "Deleted" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/ForbiddenOrCsrf" } }
      }
    },
    "/v1/agents/{agentId}/effective": {
      "get": {
        "summary": "Inspect effective Agent configuration",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/AgentId" }, { "$ref": "#/components/parameters/ProjectId" }],
        "responses": { "200": { "description": "Effective configuration", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "404": { "description": "Not found" } }
      }
    },
    "/v1/capabilities": {
      "get": {
        "summary": "List server-exposed capabilities",
        "security": [{ "sessionCookie": [] }],
        "responses": { "200": { "description": "Capabilities", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/v1/sessions": {
      "get": {
        "summary": "List owned sessions",
        "security": [{ "sessionCookie": [] }],
        "responses": { "200": { "description": "Sessions", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Sessions" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/v1/sessions/{sessionId}": {
      "get": {
        "summary": "Read an owned session transcript",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/SessionId" }],
        "responses": { "200": { "description": "Transcript", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Transcript" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" } }
      }
    },
    "/v1/chat/completions": {
      "post": {
        "summary": "Execute one authenticated chat completion",
        "security": [{ "sessionCookie": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/ChatRequest" },
        "responses": {
          "200": {
            "description": "Completion result or protocol event stream",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Completion" } },
              "text/event-stream": { "schema": { "type": "string" }, "example": "data: {\"protocol\":\"subpolar.v1\",\"requestId\":\"...\",\"sequence\":0,\"event\":{...}}\n\ndata: [DONE]\n\n" }
            }
          },
          "400": { "$ref": "#/components/responses/RequestFailed" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/ForbiddenOrCsrf" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" }
        }
      }
    },
    "/v1/ws": {
      "get": {
        "summary": "Upgrade to the authenticated Subpolar event stream",
        "security": [{ "sessionCookie": [] }],
        "x-websocket": true,
        "description": "The upgrade requires an exact same-origin Origin header. Message and event schemas are documented in docs/contracts/websocket.md.",
        "responses": { "101": { "description": "WebSocket protocol switch" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/OriginRejected" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": { "type": "apiKey", "in": "cookie", "name": "subpolar_session" }
    },
    "parameters": {
      "ProjectId": { "name": "projectId", "in": "query", "required": false, "schema": { "type": "string", "minLength": 1 } },
      "AgentId": { "name": "agentId", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1 } },
      "SessionId": { "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1 } },
      "ProviderId": { "name": "providerId", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1 } },
      "ProviderModel": { "name": "model", "in": "query", "required": false, "schema": { "type": "string" } },
      "ProviderBaseUrl": { "name": "baseUrl", "in": "query", "required": false, "schema": { "type": "string", "format": "uri" } },
      "OAuthState": { "name": "state", "in": "query", "required": true, "schema": { "type": "string" } },
      "OAuthCode": { "name": "code", "in": "query", "required": true, "schema": { "type": "string" } }
    },
    "requestBodies": {
      "Credentials": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Credentials" } } } },
      "PasswordChange": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PasswordChange" } } } },
      "ProviderSetup": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProviderSetup" } } } },
      "ModelDefaults": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ModelDefaults" } } } },
      "DeviceComplete": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeviceComplete" } } } },
      "InitialAgents": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InitialAgentsRequest" } } } },
      "ProjectCreate": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProjectCreate" } } } },
      "AgentCreate": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AgentCreate" } } } },
      "AgentUpdate": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AgentUpdate" } } } },
      "ChatRequest": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ChatRequest" } } } }
    },
    "responses": {
      "SessionCreated": { "description": "Authenticated session created", "headers": { "Set-Cookie": { "schema": { "type": "string" }, "description": "Sets subpolar_session and subpolar_csrf cookies" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SessionCreated" } } } },
      "Unauthorized": { "description": "Authentication required", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "InvalidCredentials": { "description": "Invalid credentials", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "OriginRejected": { "description": "Origin rejected", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "CsrfOrOriginRejected": { "description": "Origin or CSRF rejected", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Forbidden": { "description": "Ownership forbidden", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "ForbiddenOrCsrf": { "description": "Forbidden or CSRF rejected", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "NotFound": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "MethodNotAllowed": { "description": "Method not allowed", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "RequestFailed": { "description": "Request rejected or execution failed", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "BootstrapFailed": { "description": "Bootstrap failed", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "InvalidPassword": { "description": "Invalid password", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "InvalidProvider": { "description": "Invalid provider", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "InvalidModelDefaults": { "description": "Invalid model defaults", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Configured": { "description": "Provider configured", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Configured" } } } },
      "InvalidTemplates": { "description": "Invalid templates", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "InvalidProject": { "description": "Invalid project", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "InvalidAgent": { "description": "Invalid agent", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    },
    "schemas": {
      "Error": { "type": "object", "required": ["error"], "properties": { "error": { "type": "string" } }, "additionalProperties": false },
      "Health": { "type": "object", "required": ["status"], "properties": { "status": { "const": "ok" } }, "additionalProperties": false },
      "Ready": { "type": "object", "required": ["status"], "properties": { "status": { "const": "ready" } }, "additionalProperties": false },
      "Ok": { "type": "object", "required": ["ok"], "properties": { "ok": { "const": true } }, "additionalProperties": false },
      "BootstrapStatus": { "type": "object", "required": ["required"], "properties": { "required": { "type": "boolean" } }, "additionalProperties": false },
      "Credentials": { "type": "object", "required": ["username", "password"], "properties": { "username": { "type": "string", "minLength": 1 }, "password": { "type": "string", "minLength": 1 } }, "additionalProperties": true },
      "PasswordChange": { "type": "object", "required": ["currentPassword", "newPassword"], "properties": { "currentPassword": { "type": "string", "minLength": 1 }, "newPassword": { "type": "string", "minLength": 1 } }, "additionalProperties": true },
      "User": { "type": "object", "required": ["id", "username"], "properties": { "id": { "type": "string" }, "username": { "type": "string" } }, "additionalProperties": false },
      "UserEnvelope": { "type": "object", "required": ["user"], "properties": { "user": { "$ref": "#/components/schemas/User" } }, "additionalProperties": false },
      "SessionCreated": { "type": "object", "required": ["user", "expiresAt"], "properties": { "user": { "$ref": "#/components/schemas/User" }, "expiresAt": { "type": "string", "format": "date-time" } }, "additionalProperties": false },
      "SetupStatus": { "type": "object", "required": ["complete", "providerConfigured"], "properties": { "complete": { "type": "boolean" }, "providerConfigured": { "type": "boolean" } }, "additionalProperties": false },
      "ModelDefaults": { "type": "object", "required": ["conversation", "internal", "voice", "image"], "properties": { "conversation": { "type": "string", "minLength": 1, "maxLength": 256 }, "internal": { "type": "string", "minLength": 1, "maxLength": 256 }, "voice": { "type": "string", "minLength": 1, "maxLength": 256 }, "image": { "type": "string", "minLength": 1, "maxLength": 256 } }, "additionalProperties": false },
      "Provider": { "type": "object", "required": ["id", "label", "description", "apiMode", "authType"], "properties": { "id": { "type": "string" }, "aliases": { "type": "array", "items": { "type": "string" } }, "label": { "type": "string" }, "description": { "type": "string" }, "apiMode": { "enum": ["chat_completions", "anthropic_messages", "codex_responses", "bedrock_converse"] }, "authType": { "enum": ["api_key", "oauth", "copilot", "aws_sdk", "gcp", "external_process"] }, "requiresCredential": { "type": "boolean" }, "baseUrl": { "type": "string", "format": "uri" }, "modelsUrl": { "type": "string", "format": "uri" }, "fallbackModels": { "type": "array", "items": { "type": "string" } }, "defaultHeaders": { "type": "object", "additionalProperties": { "type": "string" } }, "credentialHeader": { "enum": ["authorization", "x-api-key", "x-goog-api-key"] }, "oauth": { "type": "object", "additionalProperties": true }, "capabilities": { "type": "object", "additionalProperties": { "type": "boolean" } }, "request": { "type": "object", "additionalProperties": true } }, "additionalProperties": false },
      "ProviderCatalog": { "type": "object", "required": ["providers"], "properties": { "providers": { "type": "array", "items": { "$ref": "#/components/schemas/Provider" } } }, "additionalProperties": false },
