{
  "name": "hermes-subpolar",
  "version": "1.0.0",
  "description": "A self-hosted Bun and TypeScript workspace application with an authenticated web UI.",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "tests-js"
  ],
  "scripts": {
    "postinstall": "echo 'Subpolar TypeScript runtime ready. Run: bun run serve'",
    "check:boundaries": "bun scripts/check-package-boundaries.mjs",
    "test:boundaries": "bun test scripts/check-package-boundaries.test.mjs",
    "check:runtime": "bun run --filter './packages/*' check",
    "check:monorepo": "bun run check:boundaries && bun run test:boundaries && bun run check:runtime",
    "sync:pi": "bash scripts/pi/sync-pi.sh",
    "typecheck:runtime": "bun run --filter './packages/*' typecheck",
    "test": "bun run --filter './packages/*' test",
    "build:web": "bun run --filter web-ui build",
    "serve": "bun run build:web && bun run --filter api-gateway serve",
    "dev": "bun run --parallel --no-orphans --workspaces --if-present dev",
    "install:root": "bun install",
    "install:web": "bun install --filter web-ui",
    "install:shared": "bun install --filter @hermes/shared",
    "audit:root": "bun audit",
    "audit:web": "bun audit",
    "audit:shared": "bun audit",
    "test:e2e:browser": "playwright test --config=tests/browser/playwright.config.ts",
    "check": "bun run --ws check",
    "fix": "bun run --ws fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreasmolnardev/hermes-subpolar.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/andreasmolnardev/hermes-subpolar/issues"
  },
  "homepage": "https://github.com/andreasmolnardev/hermes-subpolar#readme",
  "dependencies": {
    "@streamdown/math": "1.0.2",
    "agent-browser": "0.26.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "10.8.0",
    "typescript-eslint": "8.64.0",
    "eslint-plugin-perfectionist": "5.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.7.0",
    "@playwright/test": ">=1.52.0 <1.53.0",
    "typescript": ">=6.0.3 <6.1.0"
  },
  "overrides": {
    "lodash": "4.18.1",
    "yauzl": "^3.3.1",
    "protobufjs": "^8.7.1",
    "brace-expansion": "5.0.8"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "allowScripts": {
    "unicode-animations": false,
    "esbuild@0.28.1": true,
    "agent-browser@0.26.0": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
