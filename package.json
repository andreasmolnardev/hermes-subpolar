{
  "name": "hermes-agent",
  "version": "1.0.0",
  "description": "An AI agent with advanced tool-calling capabilities, featuring a flexible toolsets system for organizing and managing tools.",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "apps/*",
    "ui-tui",
    "ui-tui/packages/*",
    "web",
    "tests-js"
  ],
  "scripts": {
    "postinstall": "echo '✅ Browser tools ready. Run: python run_agent.py --help'",
    "check:boundaries": "bun scripts/check-package-boundaries.mjs",
    "test:boundaries": "bun test scripts/check-package-boundaries.test.mjs",
    "check:runtime": "bun run --filter './packages/*' check",
    "check:monorepo": "bun run check:boundaries && bun run test:boundaries && bun run check:runtime",
    "typecheck:runtime": "bun run --filter './packages/*' typecheck",
    "test": "bun run --filter './packages/*' test",
    "test:python": "scripts/run_tests.sh",
    "check:legacy": "npm run --ws check",
    "install:root": "npm install --workspaces=false",
    "install:web": "npm install --workspace web",
    "install:tui": "npm install --workspace ui-tui",
    "audit:root": "npm audit --workspaces=false",
    "audit:web": "npm audit --workspace web",
    "audit:tui": "npm audit --workspace ui-tui",
    "audit:fix:root": "npm audit fix --workspaces=false",
    "audit:fix:web": "npm audit fix --workspace web",
    "audit:fix:tui": "npm audit fix --workspace ui-tui",
    "test:e2e:browser": "playwright test --config=tests/browser/playwright.config.ts",
    "check": "npm run --ws check",
    "fix": "npm run --ws fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NousResearch/Hermes-Agent.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/NousResearch/Hermes-Agent/issues"
  },
  "homepage": "https://github.com/NousResearch/Hermes-Agent#readme",
  "dependencies": {
    "@streamdown/math": "1.0.2",
    "agent-browser": "0.26.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "typescript-eslint": "8.64.0",
    "eslint-plugin-perfectionist": "5.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.7.0"
  },
  "overrides": {
    "lodash": "4.18.1",
    "yauzl": "^3.3.1",
    "protobufjs": "^8.7.1",
    "brace-expansion": "5.0.8"
  },
  "engines": {
    "node": ">=22.22.0",
    "npm": "<11.10.0 || >=11.17.0"
  },
  "allowScripts": {
    "unicode-animations": false,
    "esbuild@0.28.1": true,
    "agent-browser@0.26.0": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
