{
  "name": "api-gateway",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./server": "./src/server.ts"
  },
  "dependencies": {
    "harness": "0.0.0",
    "tool-resolver": "0.0.0",
    "tool-runtime": "0.0.0",
    "chat-provider-interface": "0.0.0",
    "voice-provider-interface": "0.0.0",
    "data-layer": "0.0.0",
    "@hermes/shared": "0.0.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test --max-concurrency 1 test",
    "check": "bun run typecheck && bun run test",
    "serve": "bun src/server.ts",
    "dev": "bun --watch src/server.ts"
  },
  "devDependencies": {
    "@types/bun": ">=1.3.0 <1.4.0"
  }
}
