{
  "name": "web-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Browser-based Hermes Subpolar dashboard.",
  "browserDependencies": [
    "@nous-research/ui",
    "@radix-ui/react-select",
    "@tailwindcss/vite",
    "lucide-react",
    "react",
    "react-dom",
    "react-router-dom",
    "tailwindcss"
  ],
  "dependencies": {
    "@hermes/shared": "file:../shared",
    "@nous-research/ui": "0.18.2",
    "@radix-ui/react-select": "2.3.7",
    "@tailwindcss/vite": "4.3.3",
    "lucide-react": "0.577.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "7",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint-plugin-react-refresh": "0.5.3",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "fix": "bun run lint:fix",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
