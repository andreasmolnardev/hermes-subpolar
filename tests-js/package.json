{
  "name": "@hermes/root-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --exclude migration/foundation-migration.test.ts && bun test migration",
    "check": "bun run typecheck && bun run test && bun run lint",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "fix": "bun run lint:fix"
  },
  "devDependencies": {
    "@types/bun": ">=1.3.14 <1.4.0",
    "@types/node": "22.20.1",
    "@types/plist": "3.0.5",
    "plist": "3.1.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
